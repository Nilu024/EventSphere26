{
  "name": "eventsphere-backend",
  "version": "1.0.0",
  "description": "EventSphere - virtual event management and professional networking platform (backend)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "docs:api": "node scripts/generateApiDocs.js",
    "test": "cross-env NODE_ENV=test NETWORKING_DURATION_SECONDS=2 NETWORKING_START_DELAY_SECONDS=0 ENFORCE_EVENT_TIME_WINDOW=false node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "db:indexes": "node scripts/syncIndexes.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  }
}
