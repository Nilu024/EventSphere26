# ---------- Server ----------
PORT=5000                          # HTTP port
NODE_ENV=development               # development | production | test
TRUST_PROXY=0                      # number of reverse proxies in front of the app (set 1 behind Nginx/Render/Heroku)

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/eventsphere            # main database
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/eventsphere_test  # isolated DB used by `npm test` (name MUST contain "test")

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string_min_32_chars   # generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=15m                 # access-token lifetime (e.g. 15m, 1h, 1d)
BCRYPT_ROUNDS=12                   # bcrypt cost factor
COOKIE_SAMESITE=lax                # lax | strict | none (use none + HTTPS when frontend is on another site)
PASSWORD_RESET_EXPIRES_MINUTES=30  # lifetime of password-reset links

# ---------- CORS / frontend ----------
CLIENT_URL=http://localhost:5173   # trusted frontend origin(s), comma-separated

# ---------- Cloudinary (image upload; optional) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email / Nodemailer (optional; password reset emails) ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=EventSphere <no-reply@eventsphere.local>

# ---------- Speed networking ----------
NETWORKING_DURATION_SECONDS=120        # authoritative server-side session length (2 minutes)
NETWORKING_START_DELAY_SECONDS=5       # grace between match and timer start (lets both clients load Jitsi)
NETWORKING_QUEUE_TTL_SECONDS=300       # queue entries older than this are purged
NETWORKING_DISCONNECT_GRACE_SECONDS=5  # wait this long for a reconnect before cancelling a session
ENFORCE_EVENT_TIME_WINDOW=true         # attendance/networking only while the event is live (or starting soon)
ATTENDANCE_EARLY_MINUTES=30            # check-in opens this many minutes before startDate

# ---------- Jitsi ----------
JITSI_DOMAIN=meet.jit.si               # Jitsi host (use your own domain for authenticated/self-hosted deployments)
JITSI_APP_ID=                          # optional: enables signed JWTs (self-hosted prosody token auth, or JaaS app id)
JITSI_APP_SECRET=                      # optional: HS256 secret for self-hosted Jitsi JWT auth
JITSI_PRIVATE_KEY=                     # optional: RS256 PEM private key (8x8 JaaS). Use \n for newlines
JITSI_KEY_ID=                          # optional: JaaS key id (kid)

# ---------- Rate limiting / logging / docs ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300                     # per IP per window, whole API
AUTH_RATE_LIMIT_MAX=20                 # per IP per window, login/register/reset endpoints
LOG_LEVEL=info
ENABLE_SWAGGER=true                    # serve /api-docs (defaults to false in production)

# ---------- Seed script (local demo only) ----------
SEED_ADMIN_PASSWORD=ChangeMe123!
